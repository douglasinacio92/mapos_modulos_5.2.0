# Nome que aparece no login e no título das páginas (troque o APP_NAME="Map-OS" que já existe)
APP_NAME="Daitech-OS"

# --- Módulos Daitech: acrescente ao application/.env ---

# Envio automático da confirmação de visita pela Evolution API (opcional).
# Sem estas três linhas, o botão do WhatsApp abre a conversa com a mensagem pronta.
EVOLUTION_API_URL="https://api.seudominio.com.br"
EVOLUTION_API_INSTANCE="daitech"
EVOLUTION_API_KEY="cole-aqui-uma-chave-NOVA"

# API do agente (n8n). 24 caracteres ou mais. Gere com: openssl rand -hex 24
# Vazio = API desligada (responde 503).
AGENTE_API_TOKEN=""
